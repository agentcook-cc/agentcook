#!/usr/bin/env bash
# .githooks/pre-push — 跨 repo verify (防 #22 教训第 N 次 / Day 65 B + Day 69 C+D 同款)
# 自动 verify 另一 repo (agentcook ↔ agentcook-cc) 的 audit/ + progress/ 没漏 add
# 安装: cd <repo root> && git config core.hooksPath .githooks && chmod +x .githooks/pre-push

set -e

CURRENT_REPO_ROOT="$(git rev-parse --show-toplevel)"
CURRENT_REPO_NAME="$(basename "$CURRENT_REPO_ROOT")"

OTHER_REPO_ROOT=""
if [ "$CURRENT_REPO_NAME" = "agentcook-cc" ]; then
    OTHER_REPO_ROOT="$(dirname "$CURRENT_REPO_ROOT")/agentcook"
elif [ "$CURRENT_REPO_NAME" = "agentcook" ]; then
    OTHER_REPO_ROOT="$(dirname "$CURRENT_REPO_ROOT")/agentcook-cc"
else
    exit 0
fi

if [ ! -d "$OTHER_REPO_ROOT/.git" ]; then
    exit 0
fi

cd "$OTHER_REPO_ROOT"
UNTRACKED=$(git ls-files --others --exclude-standard tutorial/_internal/audit/ tutorial/_internal/progress/ 2>/dev/null || true)

if [ -n "$UNTRACKED" ]; then
    echo ""
    echo "🔴 跨 repo verify failed (Phase 6 #28 backlog 立的 hook 拦截):"
    echo ""
    echo "$OTHER_REPO_ROOT 有以下 untracked 在 audit/progress 目录:"
    echo "$UNTRACKED" | sed 's/^/  /'
    echo ""
    echo "可能 #22 教训重复发生 (B Day 65 / C+D Day 69 同款):"
    echo "  你 commit 代码到 $CURRENT_REPO_NAME 后,漏 commit 对应 audit/progress 到 $(basename $OTHER_REPO_ROOT)"
    echo ""
    echo "立刻处理:"
    echo "  cd $OTHER_REPO_ROOT"
    echo "  git add tutorial/_internal/audit/ tutorial/_internal/progress/"
    echo "  git commit + push"
    echo ""
    echo "或如果 untracked 是故意保留,本次跳过 verify:"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi

exit 0
