{
  "name": "@agentcook-cc/admin",
  "version": "0.1.0",
  "description": "Vue 3 + Element Plus admin dashboard",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint src",
    "test": "vitest run",
    "gen:api:python": "openapi-typescript ../docs/api/v1.yaml -o src/api/types.python.gen.ts",
    "gen:api:java": "openapi-typescript ../docs/api/java-v1.yaml -o src/api/types.java.gen.ts",
    "gen:api": "pnpm gen:api:python && pnpm gen:api:java"
  },
  "dependencies": {
    "@agentcook-cc/design-tokens": "workspace:*",
    "@element-plus/icons-vue": "^2.3.1",
    "@guolao/vue-monaco-editor": "^1.5.0",
    "ajv": "^8.17.0",
    "axios": "^1.7.0",
    "echarts": "^5.5.0",
    "element-plus": "^2.7.0",
    "monaco-editor": "^0.45.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.3.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.0.0"
  }
}
