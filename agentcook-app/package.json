{
  "name": "@agentcook-cc/app",
  "version": "0.1.0",
  "description": "React + Tailwind + shadcn/ui + Electron user-facing app",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "test": "vitest run",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --config electron-builder.yml",
    "gen:api:python": "openapi-typescript ../docs/api/v1.yaml -o src/api/types.python.gen.ts",
    "gen:api:java": "openapi-typescript ../docs/api/java-v1.yaml -o src/api/types.java.gen.ts",
    "gen:api": "pnpm gen:api:python && pnpm gen:api:java"
  },
  "dependencies": {
    "@agentcook-cc/design-tokens": "workspace:*",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.7.0",
    "highlight.js": "^11.9.0",
    "i18next": "^23.15.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^15.0.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^6.23.0",
    "react-virtuoso": "^4.7.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "web-vitals": "^5.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.1.3",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
