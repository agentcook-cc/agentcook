{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": [
    ".storybook/**/*",
    "stories/**/*",
    "tokens/**/*.json"
  ],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
