<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Phase 6 Week 2 PR1 (Day 68 spike `87c8d79` validated): 3.2.5
             → 3.3.7 LTS. Brings tomcat-embed-core 10.1.20 → 10.1.40+
             and netty-transport 4.1.109 → 4.1.124+ via the BOM, which
             on its own clears ~50 of the 64 Day 51 dep-check HIGH/CRITICAL
             CVEs (see _internal/audit/phase6-week2-d-prep.md §3 and
             phase6-day67-final-verify-d.md §3). grpc-bom stays at 1.63
             this PR — 1.66 breaks the GrpcServerConfigTest API surface
             (Day 68 spike showed 4 ERR there), tracked as PR2. -->
        <version>3.3.7</version>
        <relativePath/>
    </parent>

    <groupId>cc.agentcook</groupId>
    <artifactId>agentcook-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>agentcook-java</name>
    <description>AgentCook Java Business Backend - DDD Four-Layer Architecture</description>

    <modules>
        <module>agentcook-api</module>
        <module>agentcook-application</module>
        <module>agentcook-domain</module>
        <module>agentcook-infrastructure</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <springdoc-openapi.version>2.5.0</springdoc-openapi.version>
        <flyway.version>10.11.0</flyway.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <testcontainers.version>1.19.7</testcontainers.version>
        <grpc.version>1.63.0</grpc.version>
        <protobuf.version>3.25.3</protobuf.version>
        <protobuf-plugin.version>0.6.1</protobuf-plugin.version>
        <javax-annotation.version>1.3.2</javax-annotation.version>
        <jetcd.version>0.7.7</jetcd.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>cc.agentcook</groupId>
                <artifactId>agentcook-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.agentcook</groupId>
                <artifactId>agentcook-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.agentcook</groupId>
                <artifactId>agentcook-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.agentcook</groupId>
                <artifactId>agentcook-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>

            <!-- Flyway -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Testcontainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                gRPC BOM pins every io.grpc:* artifact to ${grpc.version}.
                Without it, transitive deps drag in older grpc-netty
                (jetcd-grpc 0.7.7 → grpc-netty 1.56.1, vertx-grpc 4.5.1
                → grpc-netty 1.60.0). Mixing grpc-netty 1.56 with
                grpc-core 1.63 produces NoClassDefFoundError on
                AbstractServerImplBuilder at gRPC server startup —
                masked in tests by `grpc.server.enabled=false`,
                surfaced in the docker container the moment the server
                tries to bind port 9090.
            -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Test coverage; Day 28 budget bound. Run with `mvn verify` or `mvn test jacoco:report`.
                 Day 48: protobuf/grpc generated classes excluded from coverage —
                 cc.agentcook.grpc.* is produced by protobuf-maven-plugin and contributes
                 ~1240 lines of builders/stubs that no business test should be asserting on. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <excludes>
                        <exclude>cc/agentcook/grpc/**</exclude>
                        <exclude>**/AgentcookJavaApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Day 51 (Phase 5 合规检查): OWASP dependency-check.
                 Runs on demand only — `mvn org.owasp:dependency-check-maven:check`
                 — never bound to a build phase. The first run downloads the
                 full NVD CVE feed (~500 MB) and can take 5-15 minutes; a
                 deliberate run is the right ergonomics. -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>10.0.4</version>
                <configuration>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <skipSystemScope>true</skipSystemScope>
                    <!-- CVSS >= 7.0 (HIGH/CRITICAL) fails the build when
                         we choose to run dependency-check in CI. -->
                    <failBuildOnCVSS>7.0</failBuildOnCVSS>
                    <suppressionFiles>
                        <!-- Add a file here if a finding is reviewed and
                             accepted; format = OWASP suppression XML. -->
                    </suppressionFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
