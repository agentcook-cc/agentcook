# Copy to .env (`make setup` does it for you). Every value here has a safe default.

# --- Model --------------------------------------------------------------------
# true  = offline mock model: no API key, no cost; tools and UI still run for real.
# false = a real model through the Anthropic API.
MOCK_MODE=true
ANTHROPIC_API_KEY=
# Optional: any Anthropic-compatible endpoint (a proxy or another provider).
ANTHROPIC_BASE_URL=
# Optional: pin a model id. Empty = the newest Sonnet your key can use.
MODEL_NAME=

# --- Agent loop ---------------------------------------------------------------
MAX_REASONING_ROUNDS=8
MAX_CONTEXT_MESSAGES=20
TOOL_TIMEOUT_SECONDS=15
MAX_TOOL_RESULT_CHARS=3000

# --- Go-live (chapter 25) -----------------------------------------------------
ENABLE_INPUT_GUARD=true
# Comma-separated beta allowlist of user ids; empty = open to everyone.
ALLOWED_USERS=
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Tool credentials (chapter 24 solutions) ----------------------------------
QWEATHER_API_KEY=
QWEATHER_API_HOST=
SCRAPER_API_KEY=
SALES_DB_PATH=data/sales.db
