{
  "name": "agentcook-cc",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": ["eslint --fix"],
    "*.{ts,tsx,vue,css,scss,json,md}": ["prettier --write"]
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "@playwright/test": "^1.45.0",
    "lint-staged": "^15.2.0",
    "simple-git-hooks": "^2.11.0",
    "prettier": "^3.2.0"
  }
}
