{
  "consumer": {
    "name": "agentcook-admin"
  },
  "interactions": [
    {
      "description": "list sessions for a specific user",
      "providerStates": [
        {
          "name": "the user has at least one active session"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer admin-access-token"
        },
        "method": "GET",
        "path": "/api/v1/sessions",
        "query": {
          "userId": ["00000000-0000-0000-0000-000000000001"]
        }
      },
      "response": {
        "body": [
          {
            "createdAt": "2026-05-30T10:00:00Z",
            "id": "00000000-0000-0000-0000-000000000002",
            "status": "ACTIVE",
            "title": "Debugging payment flow",
            "updatedAt": "2026-05-30T10:30:00Z",
            "userId": "00000000-0000-0000-0000-000000000001"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "create a new session for a user",
      "providerStates": [
        {
          "name": "the target user exists"
        }
      ],
      "request": {
        "body": {
          "title": "New debugging session",
          "userId": "00000000-0000-0000-0000-000000000001"
        },
        "headers": {
          "Authorization": "Bearer admin-access-token",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/sessions"
      },
      "response": {
        "body": {
          "createdAt": "2026-05-30T11:00:00Z",
          "id": "00000000-0000-0000-0000-000000000003",
          "status": "ACTIVE",
          "title": "New debugging session",
          "updatedAt": "2026-05-30T11:00:00Z",
          "userId": "00000000-0000-0000-0000-000000000001"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 201
      }
    },
    {
      "description": "list connectors for a specific plugin",
      "providerStates": [
        {
          "name": "the plugin has at least one connector configured"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer admin-access-token"
        },
        "method": "GET",
        "path": "/api/v1/connectors",
        "query": {
          "pluginId": ["00000000-0000-0000-0000-000000000004"]
        }
      },
      "response": {
        "body": [
          {
            "id": "00000000-0000-0000-0000-000000000005",
            "pluginId": "00000000-0000-0000-0000-000000000004",
            "status": "CONNECTED"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "delete an existing connector",
      "providerStates": [
        {
          "name": "the connector exists and belongs to the requesting admin"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer admin-access-token"
        },
        "method": "DELETE",
        "path": "/api/v1/connectors/00000000-0000-0000-0000-000000000005"
      },
      "response": {
        "status": 204
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "agentcook-java-crud"
  }
}
