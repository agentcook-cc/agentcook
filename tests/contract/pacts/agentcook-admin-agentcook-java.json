{
  "consumer": {
    "name": "agentcook-admin"
  },
  "interactions": [
    {
      "description": "admin password login",
      "providerStates": [
        {
          "name": "admin account with a password exists"
        }
      ],
      "request": {
        "body": {
          "password": "admin-password-123",
          "username": "admin"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/auth/login"
      },
      "response": {
        "body": {
          "accessToken": "signed.access.token",
          "expiresIn": 3600,
          "refreshExpiresIn": 2592000,
          "refreshToken": "signed.refresh.token",
          "tokenType": "Bearer"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.accessToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.expiresIn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.refreshExpiresIn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.refreshToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "admin lists users",
      "providerStates": [
        {
          "name": "an administrator and at least one user exist"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer admin-access-token"
        },
        "method": "GET",
        "path": "/api/v1/users"
      },
      "response": {
        "body": [
          {
            "createdAt": "2026-01-01T00:00:00Z",
            "email": "alice@example.com",
            "id": "00000000-0000-0000-0000-000000000001",
            "nickname": "Alice",
            "status": "ACTIVE",
            "updatedAt": "2026-01-01T00:00:00Z"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^([0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}|[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12})$"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "admin uploads a plugin zip",
      "providerStates": [
        {
          "name": "the plugin version has not been registered"
        }
      ],
      "request": {
        "body": "",
        "headers": {
          "Authorization": "Bearer admin-access-token",
          "Content-Type": "multipart/form-data; boundary=contract-boundary"
        },
        "matchingRules": {
          "body": {
            "$.file": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "contentType",
                  "value": "application/zip"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "multipart/form-data;(\\s*charset=[^;]*;)?\\s*boundary=.*"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/plugins"
      },
      "response": {
        "body": {
          "id": "00000000-0000-0000-0000-000000000002",
          "kind": "WEBHOOK",
          "name": "contract-plugin",
          "status": "DRAFT",
          "version": "1.0.0"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "agentcook-java"
  }
}
