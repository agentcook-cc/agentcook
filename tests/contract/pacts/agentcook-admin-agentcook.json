{
  "consumer": {
    "name": "agentcook-admin"
  },
  "interactions": [
    {
      "description": "a liveness probe",
      "request": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "body": {
          "status": "ok"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "list skills for the SkillListView grid",
      "request": {
        "method": "GET",
        "path": "/api/v1/skills"
      },
      "response": {
        "body": {
          "items": [
            {
              "category": "memory",
              "description": "Condense a long chat into key bullet points.",
              "id": "summarize-conversation",
              "name": "Summarize Conversation",
              "updated_at": "2026-06-03T09:00:00+00:00",
              "version": "1.0.0"
            }
          ],
          "total": 7
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "fetch one skill with its body",
      "request": {
        "method": "GET",
        "path": "/api/v1/skills/summarize-conversation"
      },
      "response": {
        "body": {
          "body": "# Summarize a conversation\n...",
          "category": "memory",
          "description": "Condense a long chat into key bullet points.",
          "id": "summarize-conversation",
          "name": "Summarize Conversation",
          "updated_at": "2026-06-03T09:00:00+00:00",
          "version": "1.0.0"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "agentcook"
  }
}
