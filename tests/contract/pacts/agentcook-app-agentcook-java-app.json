{
  "consumer": {
    "name": "agentcook-app"
  },
  "interactions": [
    {
      "description": "app login",
      "request": {
        "body": {
          "password": "contract-password-123",
          "username": "contract-reader"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/auth/login"
      },
      "response": {
        "body": {
          "accessToken": "signed.access.token",
          "expiresIn": 3600,
          "refreshExpiresIn": 2592000,
          "refreshToken": "signed.refresh.token",
          "tokenType": "Bearer"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.accessToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.expiresIn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.refreshExpiresIn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.refreshToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "app refresh",
      "request": {
        "body": {
          "refreshToken": "contract-refresh"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/auth/refresh"
      },
      "response": {
        "body": {
          "accessToken": "signed.access.token",
          "expiresIn": 3600,
          "refreshExpiresIn": 2592000,
          "refreshToken": "signed.refresh.token",
          "tokenType": "Bearer"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.accessToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.expiresIn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.refreshExpiresIn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.refreshToken": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "app current quota",
      "request": {
        "headers": {
          "Authorization": "Bearer contract-access"
        },
        "method": "GET",
        "path": "/api/v1/quota"
      },
      "response": {
        "body": {
          "free_questions_quota": 2,
          "free_questions_used": 0,
          "quota": 2,
          "remaining": 2,
          "used": 0
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.free_questions_quota": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.free_questions_used": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.quota": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.remaining": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.used": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "app current user",
      "request": {
        "headers": {
          "Authorization": "Bearer contract-access"
        },
        "method": "GET",
        "path": "/api/v1/users/me"
      },
      "response": {
        "body": {
          "createdAt": "2026-01-01T00:00:00Z",
          "email": "contract-reader@dev.local",
          "id": "00000000-0000-0000-0000-000000000001",
          "nickname": "contract-reader",
          "status": "ACTIVE",
          "updatedAt": "2026-01-01T00:00:00Z"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
