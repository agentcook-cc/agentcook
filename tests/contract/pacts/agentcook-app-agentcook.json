{
  "consumer": {
    "name": "agentcook-app"
  },
  "interactions": [
    {
      "description": "runtime info for the chat page",
      "request": {
        "method": "GET",
        "path": "/api/v1/runtime"
      },
      "response": {
        "body": {
          "agents": ["assistant"],
          "auth_mode": "optional",
          "default_agent": "assistant",
          "mock_model": true,
          "version": "2.0.0"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "the agents a user can talk to",
      "request": {
        "method": "GET",
        "path": "/api/v1/agents"
      },
      "response": {
        "body": {
          "items": [
            {
              "default": true,
              "delegates": ["researcher", "analyst"],
              "description": "General-purpose assistant.",
              "name": "assistant",
              "title": "AgentCook Assistant",
              "toolkits": ["core"]
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "the toolkits a user can enable",
      "request": {
        "method": "GET",
        "path": "/api/v1/toolkits"
      },
      "response": {
        "body": {
          "items": [
            {
              "description": "Current time and exact arithmetic.",
              "id": "core",
              "name": "Core utilities",
              "tools": [
                {
                  "description": "Evaluate an arithmetic expression.",
                  "name": "calculator"
                }
              ]
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].tools": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "one chat turn streamed as SSE",
      "request": {
        "body": {
          "agent": "assistant",
          "message": "what time is it?",
          "session_id": "c-contract-0001"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/chat/stream"
      },
      "response": {
        "headers": {
          "Content-Type": "text/event-stream; charset=utf-8"
        },
        "matchingRules": {
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^text/event-stream.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.22",
      "models": "1.2.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "agentcook"
  }
}
