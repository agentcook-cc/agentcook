{
  "name": "agentcook-rate-limit",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker — per-user 60/min + per-IP 200/min (Phase 5 backlog #11)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "tail:prod": "wrangler tail --env production",
    "kv:create:prod": "wrangler kv:namespace create RATE_LIMIT_KV --env production",
    "kv:create:staging": "wrangler kv:namespace create RATE_LIMIT_KV --env staging",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240605.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.60.0"
  }
}
